{{!
    @template mod_videoreflection/view

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
{{#hasintro}}
    <div class="videoreflection-intro mb-3">{{{intro}}}</div>
{{/hasintro}}

<div class="videoreflection-layout" id="videoreflection-root">
    <div class="videoreflection-main">
        <div class="videoreflection-player-shell">
            <div id="videoreflection-player-host" class="videoreflection-player-host"></div>
            <div id="videoreflection-timeline" class="videoreflection-timeline" aria-label="Video reflection timeline">
                {{#questions}}
                    {{#timed}}
                        <button type="button" class="videoreflection-marker videoreflection-marker-question"
                                data-seek-time="{{timepoint}}" data-marker-time="{{timepoint}}"
                                title="{{timeformatted}} — {{questiontext}}"></button>
                    {{/timed}}
                {{/questions}}
                {{#entries}}
                    {{#timed}}
                        <button type="button" class="videoreflection-marker videoreflection-marker-entry"
                                data-seek-time="{{timepoint}}" data-marker-time="{{timepoint}}"
                                data-reflection-marker="{{id}}"
                                title="{{timeformatted}} — {{reflectiontext}}"></button>
                    {{/timed}}
                {{/entries}}
            </div>
        </div>

        <div class="videoreflection-status mt-3">
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <strong>{{#str}}progress, videoreflection{{/str}}</strong>
                <span id="videoreflection-completion-label"
                      class="badge {{#complete}}bg-success{{/complete}}{{^complete}}bg-secondary{{/complete}}">
                    {{completionlabel}}
                </span>
            </div>
            <div class="progress mt-2" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="{{percentraw}}">
                <div id="videoreflection-progress-bar" class="progress-bar" style="width: {{percentraw}}%"></div>
            </div>
            <div class="videoreflection-metrics mt-2">
                <span><strong id="videoreflection-percent">{{percent}}</strong>%</span>
                <span>{{#str}}reflections, videoreflection{{/str}}: <strong
                        id="videoreflection-count">{{entrycount}}</strong></span>
                <span>{{#str}}requiredanswered, videoreflection{{/str}}:
                    <strong id="videoreflection-required">{{requiredanswered}}/{{requiredtotal}}</strong>
                </span>
            </div>
        </div>

        {{#cansubmit}}
            <div class="mt-3">
                <button type="button" class="btn btn-primary" id="videoreflection-add-current">
                    {{#str}}addreflection, videoreflection{{/str}}
                </button>
            </div>

            <div id="videoreflection-compose" class="videoreflection-compose mt-3" hidden>
                <div id="videoreflection-compose-question" class="videoreflection-compose-question" hidden></div>
                <label for="videoreflection-entrytype">{{#str}}entrytype, videoreflection{{/str}}</label>
                <select id="videoreflection-entrytype" class="form-select mb-2">
                    <option value="reflection">{{#str}}entrytype_reflection, videoreflection{{/str}}</option>
                    <option value="doubt">{{#str}}entrytype_doubt, videoreflection{{/str}}</option>
                </select>
                <label for="videoreflection-text">{{#str}}reflectiontext, videoreflection{{/str}}</label>
                <textarea id="videoreflection-text" class="form-control" rows="4"
                          placeholder="{{#str}}reflectionprompt, videoreflection{{/str}}"></textarea>
                <div class="mt-2 d-flex gap-2">
                    <button type="button" id="videoreflection-save" class="btn btn-primary">{{#str}}
                        savetoreflection, videoreflection{{/str}}</button>
                    <button type="button" id="videoreflection-cancel" class="btn btn-secondary">{{#str}}
                        cancel, videoreflection{{/str}}</button>
                </div>
            </div>
        {{/cansubmit}}

        <section class="videoreflection-section mt-4">
            <h3>{{#str}}yourreflections, videoreflection{{/str}}</h3>
            <div id="videoreflection-own-list">
                {{^hasentries}}<p id="videoreflection-empty-own" class="text-muted">{{#str}}
                    noreflections, videoreflection{{/str}}</p>{{/hasentries}}
                {{#entries}}
                    <article class="videoreflection-entry" data-reflection-id="{{id}}">
                        <div class="videoreflection-entry-meta">
                            {{#timed}}
                                <button type="button" class="btn btn-sm btn-link p-0"
                                        data-seek-time="{{timepoint}}">{{timeformatted}}</button>{{/timed}}
                            {{^timed}}<span>{{timeformatted}}</span>{{/timed}}
                            <span class="badge bg-light text-dark">{{entrytypelabel}}</span>
                            <span>{{timecreated}}</span>
                        </div>
                        <div class="videoreflection-entry-text">{{reflectiontext}}</div>
                        {{#cansubmit}}
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2"
                                    data-delete-reflection="{{id}}">
                                {{#str}}deletereflection, videoreflection{{/str}}
                            </button>
                        {{/cansubmit}}
                    </article>
                {{/entries}}
            </div>
        </section>

        {{#isshared}}
            <section class="videoreflection-section mt-4">
                <h3>{{#str}}sharedreflections, videoreflection{{/str}}</h3>
                {{^hassharedentries}}
                    <p class="text-muted">{{#str}}noreflections, videoreflection{{/str}}</p>{{/hassharedentries}}
                {{#sharedentries}}
                    <article class="videoreflection-entry videoreflection-entry-shared">
                        <div class="videoreflection-entry-meta">
                            <strong>{{author}}</strong>
                            {{#timed}}
                                <button type="button" class="btn btn-sm btn-link p-0"
                                        data-seek-time="{{timepoint}}">{{timeformatted}}</button>{{/timed}}
                            <span class="badge bg-light text-dark">{{entrytypelabel}}</span>
                            <span>{{timecreated}}</span>
                        </div>
                        <div class="videoreflection-entry-text">{{reflectiontext}}</div>
                    </article>
                {{/sharedentries}}
            </section>
        {{/isshared}}
    </div>

    <aside class="videoreflection-sidebar">
        <h3>{{#str}}reflectionquestions, videoreflection{{/str}}</h3>
        {{^hasquestions}}<p class="text-muted">{{#str}}noquestions, videoreflection{{/str}}</p>{{/hasquestions}}
        {{#questions}}
            <article
                    class="videoreflection-question {{#required}}videoreflection-question-required{{/required}} {{#answered}}videoreflection-question-answered{{/answered}}">
                <div class="videoreflection-question-meta">
                    {{#timed}}
                        <button type="button" class="btn btn-sm btn-link p-0"
                                data-seek-time="{{timepoint}}">{{timeformatted}}</button>{{/timed}}
                    {{^timed}}<span>{{timeformatted}}</span>{{/timed}}
                    <span class="badge bg-light text-dark">{{purposelabel}}</span>
                    {{#required}}<span class="badge bg-warning text-dark">{{#str}}
                        required, videoreflection{{/str}}</span>{{/required}}
                </div>
                <div class="videoreflection-question-text">{{questiontext}}</div>
                {{#cansubmit}}
                    <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                            data-answer-question="{{id}}" data-question-time="{{timepoint}}"
                            data-question-purpose="{{purpose}}" data-question-text="{{questiontext}}">
                        {{#str}}answerprompt, videoreflection{{/str}}
                    </button>
                {{/cansubmit}}
            </article>
        {{/questions}}
    </aside>
</div>
